# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Analytics 4 Measurement ID.
# Without this set, GA4 does not load (see src/lib/loadAnalytics.ts) — no
# dead tracker ships in production, and no events are silently dropped.
# Set this in Vercel: Project Settings -> Environment Variables (Production,
# and Preview if you also want tracking on preview deployments).
VITE_GA_MEASUREMENT_ID=
